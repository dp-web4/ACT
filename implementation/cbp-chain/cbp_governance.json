    },
    "LAW-OPER-001": {
      "law_id": "LAW-OPER-001",
      "category": "operational",
      "title": "Cache Hit Rate Minimum",
      "content": "Cache system must maintain minimum 80% hit rate",
      "rationale": "Ensures cache effectiveness and value delivery",
      "r6_selector": "r6.operation.cache_performance",
      "enforcement": "manual",
      "penalties": {
        "underperformance": "optimization_required",
        "atp_reduction": 10
      },
      "version": 2,
      "created_at": "2025-09-30T19:56:45.359855",
